#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <16 18 17>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <6 7>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <7 8>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        pressctr {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <11 10>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
        };

        esccombo {
            bindings = <&lt 6 ESC>;
            key-positions = <1 0>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        abc {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <21 22>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        kana {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <27 28>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        unlock {
            bindings = <&studio_unlock>;
            key-positions = <36 40>;
        };

        mouseclick {
            bindings = <&mkp MB1>;
            key-positions = <16 17>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        pressshift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <20 21>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
        };

        pressshiftr {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <29 28>;
            timeout-ms = <60>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        pressopt-alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <20 22>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        pressopt-alt-r {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <29 27>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        ctr-r {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <19 17>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        tabshift {
            bindings = <&kp LS(TAB)>;
            key-positions = <3 2>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        vol_up {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <5 6>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        vol_down {
            bindings = <&kp C_VOLUME_DOWN>;
            key-positions = <8 9>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        play_stop {
            bindings = <&kp K_PLAY_PAUSE>;
            key-positions = <15 16>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        bt0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <10 24 4>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        bt1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <0 4 24>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        bt2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <1 4 24>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        bt3 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <2 4 24>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        bt4 {
            bindings = <&bt BT_SEL 4>;
            key-positions = <3 4 24>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        bt_clr {
            bindings = <&bt BT_CLR>;
            key-positions = <4 22 24>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        bt_clr_all {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <4 21 24>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        mute {
            bindings = <&kp K_MUTE>;
            key-positions = <6 8>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        previous {
            bindings = <&kp K_PREVIOUS>;
            key-positions = <5 7>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        next {
            bindings = <&kp C_NEXT>;
            key-positions = <7 9>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <4 3>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        layer6 {
            bindings = <&mo 6>;
            key-positions = <10 20>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_BEHAVIOR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            retro-tap;
            quick-tap-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                 &kp W         &kp E           &kp R    &kp T                                       &kp Y        &kp U  &kp I           &kp O          &kp P
&kp A                 &kp S         &kp D           &kp F    &kp G                                       &kp H        &kp J  &kp K           &kp L          &lt 2 MINUS
&kp Z                 &kp X         &kp C           &kp V    &kp B                                       &kp N        &kp M  &kp COMMA       &kp DOT        &lt 4 SLASH
&mt LEFT_CONTROL TAB  &kp LEFT_ALT  &mt LCMD LANG2  &kp INS  &lt 2 SPACE  &lt 3 RCMD    &lt 3 BACKSPACE  &lt 2 ENTER         &mt RCMD LANG1  &kp RIGHT_ALT  &lt 5 TAB
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans    &mkp MB1  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &mkp MB4  &mkp MB3  &mkp MB5  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &mkp MB1            &mkp MB2  &trans  &trans
            >;
        };

        //2

        SYM {
            bindings = <
&kp EXCLAMATION       &kp AT                &kp HASH              &kp DOLLAR                  &kp PERCENT                             &kp CARET  &kp AMPERSAND  &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp MINUS             &kp EQUAL             &kp LEFT_BRACKET      &kp RIGHT_BRACKET           &kp NON_US_BACKSLASH                    &kp GRAVE  &kp SEMICOLON  &kp SQT            &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&kp UNDERSCORE        &kp PLUS              &kp LEFT_BRACE        &mt LEFT_SHIFT RIGHT_BRACE  &kp PIPE                                &kp TILDE  &kp COLON      &kp DOUBLE_QUOTES  &kp LEFT_BRACE        &kp RIGHT_BRACE
&kp LG(LS(NUMBER_3))  &kp LG(LS(NUMBER_4))  &kp LG(LS(NUMBER_5))  &trans                      &trans                &trans    &trans  &trans                    &trans             &kp COLON             &kp DOUBLE_QUOTES
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3

        Num {
            bindings = <
&kp KP_N1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5                       &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0
&kp F1     &kp F2           &kp F3           &kp F4           &kp F5                                &kp KP_ASTERISK  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS
&kp F6     &kp F7           &kp F8           &kp F9           &kp F10                               &kp KP_SLASH     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS
&kp F11    &kp F12          &to 5            &trans           &trans           &trans    &kp ENTER  &kp KP_NUMBER_0                   &kp KP_COMMA     &kp KP_DOT       &kp KP_EQUAL
            >;
        };

        //4

        Nav {
            bindings = <
&kp ESC         &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                     &kp LC(LEFT_ARROW)  &kp UP_ARROW    &kp LC(RIGHT_ARROW)  &trans           &kp LC(LA(DELETE))
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END                    &kp LEFT_ARROW      &kp DOWN_ARROW  &kp UP_ARROW         &kp RIGHT_ARROW  &kp LC(LS(ESCAPE))
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LS(LG(RIGHT_ARROW))  &trans                     &kp HOME            &kp PAGE_DOWN   &kp PAGE_UP          &kp END          &kp LC(LA(INS))
&trans          &trans                  &trans          &trans                   &trans   &trans    &trans  &trans                              &trans               &trans           &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //5

        Num_normal {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5                          &kp ASTERISK  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kt PLUS
&kp F6        &kp F7        &kp F8        &kp F9        &kp F10                         &kp SLASH     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS
&kp F11       &kp F12       &to 3         &trans        &trans        &trans    &trans  &kp NUMBER_0                &kp COMMA     &kp PERIOD    &kp EQUAL
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
